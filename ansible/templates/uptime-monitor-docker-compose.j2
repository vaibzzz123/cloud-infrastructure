services:
  uptime-kuma:
    container_name: uptime-kuma
    image: louislam/uptime-kuma:2.5.6
    restart: unless-stopped
    volumes:
      - uptime-kuma-data:/app/data

  caddy:
    container_name: caddy
    image: caddy:2.11.7
    restart: unless-stopped
    command:
      - caddy
      - reverse-proxy
      - --from
      - uptime.vabkapoor.com
      - --to
      - uptime-kuma:3001
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - caddy-data:/data
    depends_on:
      - uptime-kuma

volumes:
  uptime-kuma-data:
  caddy-data: