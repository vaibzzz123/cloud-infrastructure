# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored to protect sensitive credentials

tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaa..."
user_ocid        = "ocid1.user.oc1..aaaaaaa..."
fingerprint      = "12:34:56:78:90:ab:cd:ef:..."
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..aaaaaaa..."

ssh_public_key_path = "<path to ssh public key file on your system to ssh into all nodes>"

# Public IP ranges allowed to reach administrative ports:
# - TCP 6443 for the k3s API
# Use /32 for a single public IP.
trusted_cidrs = [
  "123.4.567.89/32",
]
